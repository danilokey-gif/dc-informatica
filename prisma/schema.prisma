generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           String         @default("TECNICO") // ADMIN | TECNICO
  assignedOrders ServiceOrder[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Customer {
  id                String               @id @default(cuid())
  name              String
  document          String?
  phone             String?
  address           String?
  email             String?
  enderLogradouro   String?
  enderNumero       String?
  enderBairro       String?
  enderCep          String?
  enderMunicipio    String?
  enderCodMunicipio String?
  enderUf           String?
  serviceOrders     ServiceOrder[]
  sales             Sale[]
  transactions      FinanceTransaction[]
  quotes            Quote[]
  cobrancasMensais  CobrancaMensal[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ServiceOrder {
  id              String               @id @default(cuid())
  customer        Customer             @relation(fields: [customerId], references: [id])
  customerId      String
  device          String
  issue           String
  technicalReport String?
  price           Float?
  status          String               @default("BUDGET")
  technician      User?                @relation(fields: [technicianId], references: [id])
  technicianId    String?
  nfseEmissoes    NfseEmissao[]
  transactions    FinanceTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  sku           String?     @unique
  description   String?
  category      String?
  costPrice     Float       @default(0)
  salePrice     Float       @default(0)
  stockQty      Int         @default(0)
  minStockAlert Int         @default(0)
  ncm           String?
  /// Código de barras (GTIN-8/12/13/14). Vazio = "SEM GTIN" na NF-e. Obrigatório informar quando o produto tem código de barras (Ajuste SINIEF 07/05).
  gtin          String?
  cfop          String?
  saleItems     SaleItem[]
  quoteItems    QuoteItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Sale {
  id            String               @id @default(cuid())
  customer      Customer?            @relation(fields: [customerId], references: [id])
  customerId    String?
  items         SaleItem[]
  total         Float
  paymentMethod String
  invoiceNumber String?
  invoiceType   String?
  status        String               @default("COMPLETED")
  transactions  FinanceTransaction[]
  nfeEmissoes   NfeEmissao[]
  createdAt     DateTime             @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Float
}

model CompanySettings {
  id                String   @id @default("main")
  name              String   @default("Dc Informática")
  /// Nome curto mostrado no sistema (menu, telas). A razão social em "name" segue nas notas.
  nomeFantasia      String?
  document          String?
  phone             String?
  email             String?
  address           String?
  logo              String?
  pixKey            String?
  pixCity           String?
  inscricaoEstadual String?
  enderLogradouro   String?
  enderNumero       String?
  enderBairro       String?
  enderCep          String?
  localDrivePath    String?
  gdriveFolderId    String?
  gdriveEmail       String?
  gdrivePrivateKey  String?
  updatedAt         DateTime @updatedAt
}

model NfseConfig {
  id                  String   @id @default("main")
  ambiente            String   @default("homologacao")
  regimeTributario    String   @default("MEI") // MEI | SIMPLES | NORMAL
  codigoMunicipio     String?
  nomeMunicipio       String?
  codigoServico       String?
  descricaoCodServico String?
  cnae                String?
  aliquotaIss         Float?
  certificado         String?
  certificadoSenha    String?
  certificadoNome     String?
  serieDps            String   @default("1")
  proximoNumeroDps    Int      @default(1)
  ultimoNsu           String?  @default("000000000000000")
  updatedAt           DateTime @updatedAt
}

model NfseEmissao {
  id                    String        @id @default(cuid())
  serviceOrder          ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId        String?
  ambiente              String
  numeroDps             Int
  serieDps              String
  status                String        @default("PROCESSANDO")
  chaveAcesso           String?       @unique
  xmlDps                String?
  xmlNfse               String?
  motivoErro            String?
  xmlPedRegEventoCancel String?
  xmlEventoCancelamento String?
  motivoCancelamento    String?
  origem                String        @default("SISTEMA") // SISTEMA | IMPORTADA_GOVERNO
  tomadorNome           String?
  tomadorDocumento      String?
  valorTotal            Float?
  /**
   * Data real de emissão (extraída do <dhEmi> do XML) — diferente de createdAt, que é quando
   * o registro foi criado aqui (pode ser bem depois, no caso de notas importadas do governo).
   */
  dataEmissao           DateTime?
  createdAt             DateTime      @default(now())
}

model NfeConfig {
  id                       String    @id @default("main")
  ambiente                 String    @default("homologacao")
  crt                      String    @default("1") // Codigo de Regime Tributario: 1=Simples Nacional (ME/EPP), 2=Simples excesso sublimite, 3=Regime Normal, 4=MEI (obrigatorio para MEI desde 01/04/2025 — com 1 a Sefaz rejeita com 481)
  codigoMunicipio          String?
  nomeMunicipio            String?
  uf                       String    @default("SP")
  cfopPadrao               String    @default("5102") // Venda de mercadoria dentro do estado, sem substituicao tributaria
  certificado              String?
  certificadoSenha         String?
  certificadoNome          String?
  serie                    String    @default("2") // serie diferente da usada no emissor externo (Sebrae), evita colisao de numeracao
  proximoNumero            Int       @default(1)
  /// Contador separado para notas de teste (homologação): testar não pode pular número das notas reais.
  proximoNumeroHomologacao Int       @default(1000)
  ultimoNsu                String?   @default("000000000000000")
  /**
   * A Sefaz exige 1h de espera depois de responder "não há mais documentos" (cStat 137), e bloqueia
   * o CNPJ por 1h (cStat 656) se consultarmos antes. Cada consulta durante o bloqueio ZERA o relógio,
   * então guardamos aqui quando a próxima consulta está liberada e nem chamamos a Sefaz antes disso.
   */
  distDfeLiberadoEm        DateTime?
  updatedAt                DateTime  @updatedAt
}

model NfeEmissao {
  id                    String    @id @default(cuid())
  sale                  Sale?     @relation(fields: [saleId], references: [id])
  saleId                String?
  ambiente              String
  numero                Int
  serie                 String
  status                String    @default("PROCESSANDO")
  chaveAcesso           String?   @unique
  xmlNfe                String?
  xmlProtocolo          String?
  motivoErro            String?
  /**
   * Justificativa enviada à Sefaz no evento de cancelamento (110111).
   */
  motivoCancelamento    String?
  /**
   * procEventoNFe do cancelamento (evento assinado + retorno da Sefaz): é o documento que comprova
   * o cancelamento e precisa ser guardado junto com a nota.
   */
  xmlEventoCancelamento String?
  origem                String    @default("SISTEMA") // SISTEMA | IMPORTADA_GOVERNO
  destinatarioNome      String?
  destinatarioDocumento String?
  valorTotal            Float?
  /**
   * Data real de emissão (extraída do <dhEmi> do XML) — diferente de createdAt, que é quando
   * o registro foi criado aqui (pode ser bem depois, no caso de notas importadas do governo).
   */
  dataEmissao           DateTime?
  createdAt             DateTime  @default(now())
}

model Supplier {
  id           String               @id @default(cuid())
  name         String
  document     String?
  phone        String?
  email        String?
  address      String?
  transactions FinanceTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model FinanceCategory {
  id           String               @id @default(cuid())
  name         String
  type         String // RECEITA | DESPESA
  transactions FinanceTransaction[]
  createdAt    DateTime             @default(now())
}

model FinanceTransaction {
  id             String           @id @default(cuid())
  type           String // RECEITA | DESPESA
  description    String
  amount         Float
  dueDate        DateTime
  paidDate       DateTime?
  status         String           @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  paymentMethod  String?
  notes          String?
  category       FinanceCategory? @relation(fields: [categoryId], references: [id])
  categoryId     String?
  supplier       Supplier?        @relation(fields: [supplierId], references: [id])
  supplierId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  customerId     String?
  sale           Sale?            @relation(fields: [saleId], references: [id])
  saleId         String?
  serviceOrder   ServiceOrder?    @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Quote {
  id         String      @id @default(cuid())
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerId String?
  items      QuoteItem[]
  total      Float
  status     String      @default("PENDING") // PENDING | APPROVED | REJECTED
  validUntil DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model QuoteItem {
  id        String   @id @default(cuid())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String
  name      String
  quantity  Int
  unitPrice Float
  isService Boolean  @default(false)
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
}

/// NF-e emitidas por FORNECEDORES contra o CNPJ da empresa (compras), recebidas pelo serviço de
/// Distribuição DF-e da Sefaz ou importadas por XML. Ficam separadas de NfeEmissao de propósito:
/// NfeEmissao são as notas que a empresa EMITIU (vendas) e alimentam faturamento e relatórios.
model NfeRecebida {
  id            String    @id @default(cuid())
  chaveAcesso   String    @unique
  nsu           String?
  emitenteCnpj  String?
  emitenteNome  String?
  emitenteIe    String?
  numero        Int?
  serie         String?
  valorTotal    Float?
  dataEmissao   DateTime?
  /**
   * 1 = autorizada, 2 = denegada, 3 = cancelada (cSitNFe do resumo, ou evento de cancelamento).
   */
  situacao      String    @default("1")
  /**
   * false = só o resumo (resNFe). A Sefaz só libera o XML completo depois que o destinatário
   * manifesta ciência da operação.
   */
  completa      Boolean   @default(false)
  /**
   * Evento de manifestação do destinatário já registrado na Sefaz (210210 = Ciência da Operação).
   * A ciência é o que faz a Sefaz liberar o XML completo na próxima busca.
   */
  manifestacao  String?
  manifestadaEm DateTime?
  xml           String
  origem        String    @default("DISTRIBUICAO_DFE") // DISTRIBUICAO_DFE | IMPORTADA_XML
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Serviço cobrado todo mês (ex.: aluguel do sistema). No dia combinado, a rotina diária
/// (/api/cron/cobrancas-mensais) cria uma OS da competência, emite a NFS-e, lança a receita pendente
/// e manda a nota com o PIX por e-mail.
model CobrancaMensal {
  id                  String    @id @default(cuid())
  customer            Customer  @relation(fields: [customerId], references: [id])
  customerId          String
  /**
   * Texto da nota; a competência (MM/AAAA) é acrescentada no fim automaticamente.
   */
  descricao           String
  valor               Float
  /**
   * Dia do mês em que a nota sai (1 a 28 — evita meses sem dia 29/30/31).
   */
  diaDoMes            Int
  /**
   * Código de tributação nacional (cTribNac, 6 dígitos) só desta cobrança.
   */
  codigoServico       String
  /// Sem uso desde o DANFSe v2.0 (a descrição vem do xTribNac da NFS-e). Mantida para não apagar coluna em produção.
  descricaoCodServico String?
  diasParaVencimento  Int       @default(10)
  /**
   * Desligada até o usuário confirmar o código de serviço com o contador.
   */
  ativa               Boolean   @default(false)
  enviarEmail         Boolean   @default(true)
  incluirPix          Boolean   @default(true)
  /**
   * 'AAAA-MM' da última competência já iniciada. É marcada ANTES de emitir: se a emissão falhar
   * sem resposta clara, a nota não é emitida de novo sozinha (evita nota em dobro); o usuário é avisado.
   */
  ultimaCompetencia   String?
  ultimoResultado     String?
  ultimoProcessamento DateTime?
  ultimaOsId          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
